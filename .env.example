# STATION8 — Environment variables template
# Copy to .env.local and fill in as integrations come online.
# All are optional during P0 (foundation). Each phase adds its own.

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity CMS (P3) ──
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ── Resend: the bookings enquiry form ──
# All three are required before app/api/bookings can deliver. Until they are set the route
# answers 503 not_configured and the form tells the guest, offering a prefilled mail draft
# instead: it must never say "sent" for an enquiry that was dropped.
# The sender must be a domain verified in Resend. Using a domain we control avoids asking Tiger
# to add DNS records; the guest's own address goes on Reply-To either way.
RESEND_API_KEY=
BOOKING_INBOX=info@station8pm.com
BOOKING_FROM_EMAIL="STATION8 Bookings <bookings@notify.k13projects.com>"

# ── Turnstile — only if the honeypot stops being enough ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Instagram Graph API (P6) ──
# Long-lived token, auto-refreshed via Vercel Cron
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Mapbox (P5) ──
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Sentry (P0, deferred until DSN available) ──
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
